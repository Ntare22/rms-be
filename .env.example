APP_ENV=development
PORT=8080

# libpq / Postgres URL used by GORM (see internal/database/postgres.go)
DATABASE_URL=postgres://rms:rms@localhost:5432/rms?sslmode=disable
APP_BASE_URL=http://localhost:5173

JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM=
MAILJET_FROM_NAME=
MAILJET_FROM_EMAIL=
MAILJET_TEMPLATE_INVITE_ID=
MAILJET_TEMPLATE_BILLING_REMINDER_ID=

SMS_PROVIDER=
SMS_API_KEY=

# Optional: enables GET /internal/status (header X-Internal-Key)
INTERNAL_JOB_SECRET=

# Max POST /auth/login and /auth/register per client IP per minute (0 = disable).
RATE_LIMIT_AUTH_RPM=30

LOG_LEVEL=info
